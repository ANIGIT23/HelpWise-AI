# HelpWise AI Backend Environment Configuration
# Copy this file to .env and replace with your real credentials:
# cp .env.example .env

# MongoDB Atlas Connection URI
# Leave empty or comment out to use the automatic in-memory development fallback.
# Format: mongodb+srv://<username>:<password>@helpwisecluster.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=HelpWiseCluster
MONGODB_URI=your_connection_string_here

# Database name inside MongoDB Atlas (Default: helpwise_ai)
DATABASE_NAME=helpwise_ai

# Environment mode: development / staging / production
ENVIRONMENT=development

