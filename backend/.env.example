# HelpWise AI Backend Environment Configuration
# Copy this file to .env and replace with your real credentials:
# cp .env.example .env

# MongoDB Atlas Connection URI
# Leave empty or comment out to use the automatic in-memory development fallback.
# Format: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URI=

# Database name inside MongoDB Atlas
DATABASE_NAME=helpwise_db

# Environment mode: development / staging / production
ENVIRONMENT=development
