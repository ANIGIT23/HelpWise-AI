# HelpWise AI Backend Environment Configuration
# Copy this file to .env and replace with your real credentials:
# cp .env.example .env

# MongoDB Atlas Connection URI
# Leave empty or comment out to use the automatic in-memory development fallback.
# Format: mongodb+srv://<username>:<password>@helpwisecluster.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=HelpWiseCluster
MONGODB_URI=your_connection_string_here

# Database name inside MongoDB Atlas (Default: helpwise_ai)
DATABASE_NAME=helpwise_ai

# Environment mode: development / staging / production
ENVIRONMENT=development

# Optional: Local LLM Model Configuration
# HELPWISE_LLM_MODEL=google/flan-t5-small
# HELPWISE_LLM_ENABLED=1

# Optional: ServiceNow Table API Integration
# Configure with your Personal Developer Instance (PDI) to enable live incident synchronization.
# If omitted, HelpWise operates in transparent Simulation Mode.
# SERVICENOW_INSTANCE=https://dev461045.service-now.com
# SERVICENOW_USER=admin
# SERVICENOW_PASSWORD=your_instance_password_here
